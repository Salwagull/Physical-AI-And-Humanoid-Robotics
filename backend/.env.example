# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials!

# =============================================================================
# RAG Pipeline Services
# =============================================================================

# Cohere API for embeddings
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# Qdrant Cloud for vector storage
# Get from: https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# OpenRouter for LLM generation
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# =============================================================================
# Authentication Configuration
# =============================================================================

# JWT Secret Key (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=generate-a-secure-secret-key-here

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend URL for CORS and OAuth redirects
# Development: http://localhost:3000
# Production: https://salwagull.github.io/Physical-AI-And-Humanoid-Robotics
FRONTEND_URL=http://localhost:3000

# =============================================================================
# OAuth Providers (optional - leave empty to disable)
# =============================================================================

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
